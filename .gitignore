.vs/
.vscode/
.idea/
*.user
*.rsuser
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# ---- Test / coverage ----
[Tt]est[Rr]esults/
[Cc]overage*/
