<Project>

  <!-- Chain to the repo-root Directory.Build.props; MSBuild otherwise stops here. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    Product code is held to warnings-as-errors (Execution Plan Part 1 requires
    this for Core "at minimum"; App and Remote are held to the same bar).
    The test project deliberately stays out of this so analyzer noise in test
    scaffolding can never block a red/green cycle.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      The documentation files exist so that the compiler checks the doc comments (issue #19,
      root Directory.Build.props). Nothing at runtime reads them, so a publish leaves them
      out and the release package holds the same files as before.
    -->
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

</Project>
