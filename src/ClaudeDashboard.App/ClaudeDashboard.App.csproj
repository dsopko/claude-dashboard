<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Impl 1.2 — the Windows host: WPF UI, ingress, and every Win32/UIA/COM
    adapter. References Core. Nothing but the test project may reference this.
    Publish settings (win-x64, self-contained, single-file) land in T1.19.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ClaudeDashboard.App</RootNamespace>
    <AssemblyName>ClaudeDashboard.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <StartupObject>ClaudeDashboard.App.Program</StartupObject>
  </PropertyGroup>

  <!--
    App.xaml is compiled as a Page rather than as the ApplicationDefinition. As an
    ApplicationDefinition, WPF generates its own entry point that constructs `new App()` —
    which collides with Program.Main (CS0017) and does not compile at all once App takes a
    constructor argument. As a Page it still generates InitializeComponent and the resource
    loading T1.11 will use, and the entry point stays ours. See Program's remarks.
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeDashboard.Core\ClaudeDashboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
