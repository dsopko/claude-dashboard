<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Impl 1.2 — the Windows host: WPF UI, ingress, and every Win32/UIA/COM
    adapter. References Core. Nothing but the test project may reference this.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ClaudeDashboard.App</RootNamespace>
    <AssemblyName>ClaudeDashboard.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!--
      Issue #17 — the identity mark. Compiled into the apphost rather than shipped beside it,
      so the publish output gains no file. MainWindow sets no Icon and does not need one: WPF
      falls back to the executable's icon, so the title bar, the taskbar button and Alt-Tab all
      follow from this one line. Deleting it costs nothing at build time and quietly returns the
      stock .NET icon, which is why IconAssetTests reads this property back.

      Not the tray glyph. Ui/TrayIcons.cs draws a status light that changes colour; this is a
      fixed mark. They are separate on purpose and share nothing.

      Regenerable from docs/Claude Dashboard Icon-selection.png, the operator's own sheet. It is
      drawn at 2x throughout, so every step below is a reduction and none is an upscale:

        magick "docs\Claude Dashboard Icon-selection.png" -crop 512x512+58+54 +repage app-512.png
        magick app-512.png -alpha set -fuzz 5% -fill none
          -draw "alpha 0,0 floodfill"   -draw "alpha 511,0 floodfill"
          -draw "alpha 0,511 floodfill" -draw "alpha 511,511 floodfill" app-512-rounded.png
        magick app-512-rounded.png -resize 256x256 app-256.png
        magick app-256.png -define icon:auto-resize=256,48,32,16 Assets\app.ico

      The crop is the 256 tile, verified on the sheet: the outline spans x 58..569 and y 54..565,
      512 px each way.

      The fuzz is 5% because the tile interior and the sheet background are the same colour,
      #14130F, and only the gold outline separates them. The floodfill therefore follows the
      drawn curve and no corner radius has to be guessed. At 10% it crosses the outline's
      antialiasing and hollows the icon out, leaving a gold ring around nothing: 7,268
      transparent pixels at 5%, 239,635 at 10%. Both numbers are measured. 5% is half the
      distance to that edge and still clears the dark fringe outside the curve.
    -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

  </PropertyGroup>

  <!--
    T1.19 — the shipping shape (Impl 10.2): win-x64, self-contained, one file.
    Not MSIX: its sandboxing fights writing the scheduled task and merging
    Claude Code's settings, and this tool must do both.

    Conditioned on a RuntimeIdentifier being supplied, which is what keeps an
    ordinary `dotnet build` and the whole test suite exactly as they were. A RID
    set unconditionally here would make every build runtime-specific and move
    the output directory under a RID folder — so the test project, which loads
    the Core assembly from beside its own binaries, would be looking in a path
    that no longer exists. The publish command supplies -r; nothing else does.

    Deliberately absent, each for a reason:
      * EnableCompressionInSingleFile — costs startup time on every logon to
        save disk that is not scarce, on an app whose whole job is to be there
        already when the operator looks.
      * InvariantGlobalization — the tray tooltip and the row ages render
        through CurrentCulture (Impl 5.2), so dropping ICU would change what
        the operator reads.
      * PublishReadyToRun — a real startup win and a large size cost; worth
        measuring later against a stopwatch rather than adopting on faith.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>

    <!--
      Without this the native dependencies sit beside the exe as loose DLLs, which is the
      failure that only shows up when somebody copies "the exe" somewhere on its own.
    -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!--
      App's symbols go inside the executable. Core's do not: it builds with its own defaults and
      emits ClaudeDashboard.Core.pdb beside the exe, and that is left alone deliberately —
      shipping it is what makes a crash in Core symbolicate.
    -->
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    So "single file" ships as three entries, and all three are intended: the executable, the
    Core symbols above, and sounds\ — which Impl Part 8 requires beside the exe rather than
    embedded, because an operator replaces a shipped sound by dropping a like-named file into
    their config folder, and a resource compiled into the assembly could neither be compared
    with nor shadowed by a file on disk. The property above is about native *dependencies*
    being bundled, not about the folder holding exactly one item.
  -->

  <!--
    App.xaml is compiled as a Page rather than as the ApplicationDefinition, which is what
    leaves Program.Main as the only entry point in the assembly. As an ApplicationDefinition,
    WPF generates an entry point of its own that constructs `new App()` — which collides with
    ours (CS0017) and stops compiling altogether once App takes a constructor argument. As a
    Page it still generates InitializeComponent and the resource loading T1.11 will use.

    There is deliberately no <StartupObject>: with one Main there is nothing to disambiguate,
    and naming one would imply it is what prevents the collision. It is not — StartupObject
    chooses between entry points, it does not stop the generated one from failing to compile.
    See Program's remarks.
  -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ASP.NET Core by framework reference rather than by package, which is what Impl
      Appendix A specifies ("via the Web SDK / framework reference"). This is what Kestrel
      and the minimal API in Ingress need (Impl §3.1). Core must never acquire this — T1.0's
      Core_takes_no_WPF_Win32_or_AspNet_reference fails the build if it does.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaudeDashboard.Core\ClaudeDashboard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      A view model's backing record is set by MainViewModel and by nothing else in production,
      so those setters are internal. Tests need to drive them directly to assert what a row does
      when its record is replaced; widening them to public to make that possible would put a
      mutator on the API surface purely for the benefit of the tests.
    -->
    <InternalsVisibleTo Include="ClaudeDashboard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The sounds that ship with the app (Impl Part 7). Copied beside the executable rather than
      embedded, because Part 8 lets the operator replace one by dropping a like-named file into
      the config folder — a resource compiled into the assembly could not be compared with, or
      shadowed by, a file on disk.
    -->
    <Content Include="Assets\sounds\*.wav" Link="sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />

    <!--
      DO NOT REMOVE THIS PIN WHILE TIDYING. It is not a stray transitive reference.

      Microsoft.Data.Sqlite 10.0.0 resolves SQLitePCLRaw.lib.e_sqlite3 2.1.11, which carries a
      KNOWN HIGH SEVERITY ADVISORY: NU1903 / GHSA-2m69-gcr7-jv3q. Deleting this line reintroduces
      it, and the only symptom is a restore warning that is easy to scroll past.

      2.1.13 is the smallest version that clears it. Verified working rather than merely quiet:
      with this pin the native library loads, reports SQLite 3.53.3, and opens, creates and
      inserts. 3.53.3 as a package version also clears the advisory but is a major jump away from
      what the bundle expects, in exchange for nothing.
    -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />

    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
