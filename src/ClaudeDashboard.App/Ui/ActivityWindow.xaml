<Window x:Class="ClaudeDashboard.App.Ui.ActivityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClaudeDashboard.App.Ui"
        Title="Activity"
        Width="640"
        Height="480"
        MinWidth="260"
        MinHeight="200"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        The Activity window (T1.70, issue #97): what the dashboard did since it started, newest first, in
        plain words. The lines are ActivityLog's one list, in memory, fed from the consumer's decisions since the
        start; nothing is read from dashboard.db. The window is made at start and only hidden when it closes.
        The list is virtualized, and collapsed while the window is hidden, so lines added then cost no layout. Nothing here
        moves: no storyboard, no fade, so the motion rule holds.

        The layout follows the width (ActivityViewModel.LayoutFor): one line in columns when wide; two lines
        when narrow, the second small and grey; narrower still, the detail goes first, then the project. The
        time, the sound sign, what occurred and the name never go, and the hover on a line holds everything.

        A click on a line, and Enter on a selected line, show its row in the main window (T1.71): through the
        line's ShowCommand, never a handler here. "Show activity" on a row filters the list to that session: the
        list shows ActivityViewModel.Shown, a view over the one list, and the bar at the top says so.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClaudeDashboard.App;component/Ui/RowTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ActivityText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ActivitySmall" TargetType="TextBlock" BasedOn="{StaticResource ActivityText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <!--
                The footer's row has a fixed height, there from the start (the T1.71 review): the list's height never
                changes when the footer appears, and a new line never measures the footer's row again.
            -->
            <RowDefinition x:Name="FooterRow" Height="28" />
        </Grid.RowDefinitions>

        <!-- "last heard from Claude Code …", the tray tooltip's own words (T1.61). -->
        <TextBlock x:Name="LastHeardLine"
                   Grid.Row="0"
                   Margin="12,10,12,6"
                   Style="{StaticResource ActivitySmall}"
                   Text="{Binding LastHeardText}" />

        <!-- "Only Director" with Show all, while the list shows one session's lines (T1.71). -->
        <DockPanel x:Name="FilterBar"
                   Grid.Row="1"
                   Margin="12,0,12,6"
                   Visibility="{Binding IsFiltered, Converter={StaticResource BoolToVisible}}">
            <Button x:Name="ShowAllButton"
                    DockPanel.Dock="Right"
                    Content="Show all"
                    Style="{StaticResource HeaderButtonStyle}"
                    Command="{Binding ShowAllCommand}"
                    ToolTip="List every line again." />
            <TextBlock x:Name="FilterText"
                       Text="{Binding OnlyText}"
                       Style="{StaticResource ActivityText}"
                       FontWeight="SemiBold" />
        </DockPanel>

        <ListBox x:Name="ActivityList"
                 Grid.Row="2"
                 ItemsSource="{Binding Shown}"
                 IsSynchronizedWithCurrentItem="False"
                 ui:ActivityLayoutHost.Layout="{Binding Layout}"
                 Background="Transparent"
                 BorderThickness="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 Grid.IsSharedSizeScope="True">
            <!-- Enter on a selected line does what a click does: the line's own command. -->
            <ListBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding SelectedItem.ShowCommand, ElementName=ActivityList}" />
            </ListBox.InputBindings>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,3" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Sentence}" />
                    <Setter Property="AutomationProperties.HelpText" Value="{Binding GoneText}" />
                    <Setter Property="ToolTip" Value="{Binding Hover}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="LineSurface" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <!-- A click on the line shows its row in the main window (T1.71). -->
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" Command="{Binding ShowCommand}" />
                                    </Border.InputBindings>
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="LineSurface" Property="Background" Value="{StaticResource RaisedBrush}" />
                                    </Trigger>
                                    <!-- The selected line, for Enter: the main window's selected-row colour. -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="LineSurface" Property="Background" Value="{StaticResource SelectedRowBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:ActivityLineViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <!-- Shared across the realized lines, so the wide form reads as columns. -->
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="What" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Name" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Project" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TimeText" Grid.Column="0" Text="{Binding Time}" Style="{StaticResource ActivitySmall}" />
                        <TextBlock x:Name="SignText" Grid.Column="1" Text="{Binding Sign}" Style="{StaticResource ActivityText}" />
                        <TextBlock x:Name="WhatText" Grid.Column="2" Margin="0,0,10,0" Text="{Binding What}" Style="{StaticResource ActivityText}" />
                        <TextBlock x:Name="NameText" Grid.Column="3" Margin="0,0,10,0" Text="{Binding Name}" Style="{StaticResource ActivityText}" FontWeight="SemiBold" />

                        <!-- Wide: the project and the detail in their own columns. -->
                        <TextBlock x:Name="WideProject" Grid.Column="4" Margin="0,0,10,0" Text="{Binding Project}"
                                   ToolTip="{Binding ProjectPath}" Style="{StaticResource ActivitySmall}" />
                        <TextBlock x:Name="WideDetail" Grid.Column="5" Text="{Binding Detail}" Style="{StaticResource ActivitySmall}" />

                        <!-- Narrow: the second line, small and grey. The detail goes first, then the project. -->
                        <StackPanel x:Name="SecondLine" Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                                    Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock x:Name="NarrowProject" Text="{Binding Project}" ToolTip="{Binding ProjectPath}"
                                       Style="{StaticResource ActivitySmall}" />
                            <TextBlock x:Name="NarrowSeparator" Text=" · " Style="{StaticResource ActivitySmall}" />
                            <TextBlock x:Name="NarrowDetail" Text="{Binding Detail}" Style="{StaticResource ActivitySmall}" />
                        </StackPanel>
                    </Grid>

                    <DataTemplate.Triggers>
                        <!-- Nothing to show leaves no gap and no separator. -->
                        <DataTrigger Binding="{Binding HasProject}" Value="False">
                            <Setter TargetName="NarrowProject" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NarrowSeparator" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasDetail}" Value="False">
                            <Setter TargetName="NarrowSeparator" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <!-- Two lines: the project and the detail move to the second line. -->
                        <Trigger Property="ui:ActivityLayoutHost.Layout" Value="TwoLines">
                            <Setter TargetName="WideProject" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WideDetail" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SecondLine" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- Narrower: the detail goes. -->
                        <Trigger Property="ui:ActivityLayoutHost.Layout" Value="NoDetail">
                            <Setter TargetName="WideProject" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WideDetail" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SecondLine" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NarrowDetail" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="NarrowSeparator" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!-- Narrowest: the project goes too, and the line is one line. -->
                        <Trigger Property="ui:ActivityLayoutHost.Layout" Value="NoProject">
                            <Setter TargetName="WideProject" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="WideDetail" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SecondLine" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- The bottom of the list, once the oldest lines have gone: 19,000 to 20,000 of the newest are kept. -->
        <TextBlock x:Name="DroppedLine"
                   Grid.Row="3"
                   Margin="12,0,12,4"
                   Style="{StaticResource ActivitySmall}"
                   Text="{Binding Log.DroppedLine}"
                   Visibility="{Binding Log.HasDropped, Converter={StaticResource BoolToVisible}}" />
    </Grid>
</Window>
