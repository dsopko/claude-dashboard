<Window x:Class="ClaudeDashboard.App.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:ClaudeDashboard.App.Ui"
        Title="Claude Dashboard"
        Width="400" Height="760"
        MinWidth="320" MinHeight="240"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!--
        The narrow side panel of Design Document §9, under the branded caption of design option
        2c. Every colour, size and space in the caption is a named resource read off that design;
        there is no hex literal in this file.
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ClaudeDashboard.App;component/Ui/RowTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:InverseBooleanConverter x:Key="InverseBool" />
        </ResourceDictionary>
    </Window.Resources>

    <!--
        THE CAPTION IS OURS NOW, AND THE WINDOW IS STILL A WINDOW.

        WindowChrome rather than WindowStyle="None" with AllowsTransparency="True": that pair
        makes the HWND layered, and a layered window loses the DWM drop shadow, the Windows 11
        rounded corners and the snap animations — none of which can be drawn back in XAML.
        WindowStyle therefore stays at its default and GlassFrameThickness keeps a one-pixel
        frame extended into the client area, which is what the shadow hangs from. Nothing paints
        there: the root Border below is opaque over it.

        CaptionHeight is the design's 48 and is read from the same resource the caption's own
        Border is sized by, so the drag region and the drawn bar cannot drift apart.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="{StaticResource CaptionHeight}"
                            GlassFrameThickness="0,0,0,1"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
        The caption buttons go through SystemCommands, which is what makes them the system's
        actions rather than imitations of them. Close in particular: SystemCommands.CloseWindow
        raises the same close the stock X raised, so OnClosing still cancels it and hides — the
        button's meaning is inherited rather than restated.
    -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.MinimizeWindowCommand}" Executed="OnMinimizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.MaximizeWindowCommand}" Executed="OnMaximizeWindow" />
        <CommandBinding Command="{x:Static SystemCommands.RestoreWindowCommand}" Executed="OnRestoreWindow" />
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindow" />
    </Window.CommandBindings>

    <!--
        RootBorder carries the maximized inset. A WindowChrome window's rect is inflated past the
        work area by its frame while maximized, and with the non-client area gone that inflation
        is content hanging off the screen. MainWindow.ApplyMaximizedInset gives it back.
    -->
    <Border x:Name="RootBorder" Background="{StaticResource SurfaceBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ==== Caption: icon · title · summary · help · window buttons (option 2c) ======== -->
            <Border Grid.Row="0"
                    Height="{StaticResource CaptionHeight}"
                    Background="{StaticResource CaptionBrush}"
                    BorderBrush="{StaticResource CaptionRuleBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <!-- The warm light off the top right, over the vertical wash. -->
                    <Rectangle Fill="{StaticResource CaptionGlowBrush}" />

                    <!--
                        A GRID, NOT A DOCKPANEL, AND THE STARRED COLUMN IS THE POINT. Everything
                        but the summary is fixed: the icon, the title, the divider, the help slot
                        and the three window buttons all take what they need. The summary takes
                        what is left, which is what lets it know how much of itself it can show.
                        A DockPanel would hand it infinity and it would clip instead.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--
                            The application icon of issue #17, at the design's 20 DIP. The 32 px
                            frame is asked for by name: 20 DIP is 20 device pixels at 100% and 30
                            at 150%, so the 32 is a reduction at every scaling this runs at, and a
                            reduction is what stays crisp. The 16 would have to be enlarged.
                        -->
                        <Image Grid.Column="0"
                               Width="20" Height="20" Margin="14,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Source>
                                <BitmapImage UriSource="/ClaudeDashboard.App;component/Assets/app.ico"
                                             DecodePixelWidth="32" />
                            </Image.Source>
                        </Image>

                        <TextBlock Grid.Column="1"
                                   Text="Claude Dashboard"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource TitleFont}"
                                   FontSize="15"
                                   FontWeight="Medium"
                                   Foreground="{StaticResource InkBrush}" />

                        <StackPanel Grid.Column="5" Orientation="Horizontal">
                            <Button Style="{StaticResource CaptionButtonStyle}"
                                    Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                                    AutomationProperties.Name="Minimize"
                                    ToolTip="Minimize">
                                <Path Data="M0,5 H10" StrokeThickness="1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource CaptionMaximizeButtonStyle}"
                                    Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                                    AutomationProperties.Name="Maximize"
                                    ToolTip="Maximize">
                                <Rectangle Width="9" Height="9" StrokeThickness="1"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <!--
                                2c draws no maximized window, so this glyph is the platform's own
                                overlapping squares rather than anything read off the design. The
                                alternative was to leave the maximize square showing on a window
                                that is already maximized, which would be wrong rather than
                                merely unspecified.
                            -->
                            <Button x:Name="RestoreButton"
                                    Style="{StaticResource CaptionRestoreButtonStyle}"
                                    Command="{x:Static SystemCommands.RestoreWindowCommand}"
                                    AutomationProperties.Name="Restore"
                                    ToolTip="Restore">
                                <Path Data="M0,3 H7 V10 H0 Z M3,3 V0 H10 V7 H7" StrokeThickness="1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>

                            <Button Style="{StaticResource CaptionCloseButtonStyle}"
                                    Command="{x:Static SystemCommands.CloseWindowCommand}"
                                    AutomationProperties.Name="Close"
                                    ToolTip="Close to the tray">
                                <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </StackPanel>

                        <!--
                            THE COUNTS STRIP, MOVED RATHER THAN COPIED. It read the same numbers
                            on the row below until 2c gave the caption a summary slot and left the
                            row to its controls; it is one strip and there is still one of it.

                            2c's slot shows "11 sessions · 3 need you" and stops there, but the
                            unread and working counts are not the mockup's to drop — they are what
                            the operator has been reading, and this task changes where the window
                            says things and not what it says. They keep their brushes and their
                            zero-collapsing, and follow "need you" in the same separated pattern.

                            AND ALL FOUR DO NOT FIT, which is the one place 2c had to bend. The
                            design is drawn in an 820-pixel window; this one opens at 520, where
                            the slot holds 150 pixels and the four counts want 244. So the strip
                            is a FittingStrip: it shortens its words while that is enough, and
                            drops whole counts from the right once it is not.

                            MEASURED AT 100% DISPLAY SCALING, at the counts a fifteen-session
                            dashboard actually reaches — a two-digit total and single-digit
                            bands. The scale is part of the measurement and not a detail of it:
                            Display formatting quantizes glyph advances to whole DEVICE pixels,
                            so every number below moves with the monitor. What does not move is
                            the order — words before counts, and counts from the right — and that
                            is what FittingStripTests asserts. The figures here are the 100% ones.

                            The caption's fixed furniture is 370: icon 48, title 121, 14 before
                            the strip, divider 29, help slot 20, and 138 for the three window
                            buttons. On top of that:

                              tier 0   "11 sessions . 3 need you . 5 unread . 8 working"   614
                              tier 1   "11 . 3 need . 5 unread . 8 working"                545

                            WHAT 150% DOES, AND WHAT IS WORTH WRITING DOWN ABOUT IT. The strip
                            measures WIDER there, not narrower: the reviewer and I both get
                            247.333 for the long form against 244 here, on a monitor set to it.
                            A third figure, 242, was written into this remark earlier in the same
                            task and does NOT reproduce — not on their machine and not on mine an
                            hour later, with the same script. I could not account for it, so it
                            is withdrawn rather than explained away, and no 150% width is
                            recorded here: a number nobody can reproduce is worse than none, and
                            this remark has now carried two.

                            WHAT DOES HOLD, re-measured after the above: A 520 WINDOW SHOWS THREE
                            COUNTS AT BOTH SCALES. That is the fact the operator needs, it is
                            about behaviour rather than pixels, and it is the one this window is
                            actually judged on. FittingStripTests states every rule against
                            widths it measures in the same run for exactly this reason.

                            So the 520 this window opens at shows three counts. ALL FOUR NEVER
                            FIT AT 520 while the help slot is kept, and keeping it was the
                            operator's call: that slot and its divider are 49 of the 370, and
                            without them tier 1 would fit whole at 494.

                            Tabular figures per the design's font-feature-settings:'tnum', so a
                            count ticking 9 -> 10 does not shove the words beside it.
                        -->
                        <ui:FittingStrip Grid.Column="2"
                                         VerticalAlignment="Center"
                                         HorizontalAlignment="Right"
                                         ClipToBounds="True"
                                         Margin="14,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SessionCount}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <!--
                                    HideAtTier rather than Labels, because this word is bound —
                                    it is "session" or "sessions" — and writing Text locally
                                    would kill the binding. Tier 1 takes the word and leaves the
                                    number, which is the cheapest 44 pixels on the ladder.
                                -->
                                <TextBlock Text="{Binding SessionsWord}"
                                           ui:FittingStrip.HideAtTier="1"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding NeedsYouCount, Converter={StaticResource ZeroToCollapsed}}">
                                <TextBlock Text=" · " FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                                <TextBlock Text="{Binding NeedsYouCount}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource RedBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <!--
                                    The only count whose word is worth shortening: "unread" and
                                    "working" are one word already, and abbreviating either would
                                    cost more meaning than the four pixels it saved.
                                -->
                                <TextBlock ui:FittingStrip.Labels=" need you| need"
                                           FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding UnreadCount, Converter={StaticResource ZeroToCollapsed}}">
                                <TextBlock Text=" · " FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                                <TextBlock Text="{Binding UnreadCount}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource GreenBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text=" unread" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding WorkingCount, Converter={StaticResource ZeroToCollapsed}}">
                                <TextBlock Text=" · " FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                                <TextBlock Text="{Binding WorkingCount}"
                                           FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource BlueBrush}"
                                           Typography.NumeralAlignment="Tabular" />
                                <TextBlock Text=" working" FontFamily="{StaticResource UiFont}" FontSize="12"
                                           Foreground="{StaticResource Ink2Brush}" />
                            </StackPanel>
                        </ui:FittingStrip>

                        <Rectangle Grid.Column="3"
                                   Width="1" Height="18" Margin="14,0"
                                   VerticalAlignment="Center"
                                   Fill="{StaticResource HairlineBrush}" />

                        <Button Grid.Column="4"
                                Content="?"
                                Margin="0,0,14,0"
                                Style="{StaticResource CaptionHelpButtonStyle}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Help"
                                ToolTip="Help has no home yet; the slot is here for it." />
                    </Grid>
                </Grid>
            </Border>

            <!-- ==== Toolbar: Grouped/Flat · Select · Mute all (option 2c's idle row) ========== -->
            <Border Grid.Row="1" Padding="12,10"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="6"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="GroupedToggle"
                                          Content="Grouped"
                                          Style="{StaticResource SegmentStyle}"
                                          IsChecked="{Binding IsGrouped, Mode=TwoWay}" />
                            <ToggleButton Content="Flat"
                                          Style="{StaticResource SegmentStyle}"
                                          IsChecked="{Binding IsGrouped, Mode=TwoWay, Converter={StaticResource InverseBool}}" />
                        </StackPanel>
                    </Border>

                    <!--
                        SELECTION MODE, AND IT ANNOUNCES ITSELF (Design Document §9). That is the
                        whole answer to "a mode is a state and a state can be wrong": a mode that can
                        be on unseen is a mode nobody knows is on. Off, it costs one button; on, the
                        row says so and carries the count and both ways out of it.

                        2c draws only the idle row, so only the idle row is restyled. What the
                        mockup does not show still works exactly as it did.
                    -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,10,0">
                        <Button x:Name="BeginSelectionButton"
                                Content="Select"
                                Style="{StaticResource HeaderButtonStyle}"
                                Command="{Binding BeginSelectionCommand}"
                                Visibility="{Binding IsSelecting, Converter={StaticResource BoolToCollapsed}}"
                                ToolTip="Pick sessions to group together." />

                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsSelecting, Converter={StaticResource BoolToVisible}}">
                            <TextBlock x:Name="SelectionText"
                                       Text="{Binding SelectionText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontFamily="{StaticResource UiFont}"
                                       FontSize="11.5"
                                       Foreground="{StaticResource Ink2Brush}" />
                            <Button x:Name="GroupTheseButton"
                                    Content="Group these"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Margin="0,0,6,0"
                                    Command="{Binding GroupSelectedCommand}" />
                            <Button x:Name="CancelSelectionButton"
                                    Content="Cancel"
                                    Style="{StaticResource HeaderButtonStyle}"
                                    Command="{Binding CancelSelectionCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <!--
                        Mute all belongs to the tray's menu (Impl §5.2) and per-session mute to the
                        sound engine (T1.5). The row keeps §9's slot for it, inert until then.
                    -->
                    <Button Grid.Column="3" Content="Mute all"
                            Style="{StaticResource HeaderReservedButtonStyle}"
                            ToolTip="Muting arrives with the tray menu (T1.13)." />
                </Grid>
            </Border>

            <!-- ==== Body: the rows, in the order T1.10 assembled them ========================= -->
            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl x:Name="RowsHost" ItemsSource="{Binding Rows}" KeyboardNavigation.TabNavigation="Continue">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
