<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:ClaudeDashboard.App.Ui">

    <!--
        The dashboard's rows (Design Document §9; docs/claude-dashboard-mockups.html).

        MOTION LIVES HERE AND NOWHERE ELSE. Design Document §9: "red blinks; working breathes;
        nothing else moves." There are exactly two Storyboards in this file and each is reached
        only through a DataTrigger on SessionViewModel.Motion — which is already gated on the
        operator's reduced-motion setting (see MotionPolicy). A test walks this dictionary and
        fails if a third animation ever appears, or if one is triggered by anything else.
    -->

    <!-- ==== Palette (mockups' :root) =========================================================== -->
    <Color x:Key="PageColor">#FF101214</Color>
    <SolidColorBrush x:Key="PageBrush" Color="{StaticResource PageColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FF22262B" />
    <SolidColorBrush x:Key="RaisedBrush" Color="#FF282D33" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#FF343A41" />
    <SolidColorBrush x:Key="InkBrush" Color="#FFE8EAED" />
    <SolidColorBrush x:Key="Ink2Brush" Color="#FF9AA3AD" />
    <SolidColorBrush x:Key="Ink3Brush" Color="#FF6B7480" />
    <SolidColorBrush x:Key="RedBrush" Color="#FFFF6B5E" />
    <SolidColorBrush x:Key="GreenBrush" Color="#FF55C96A" />
    <SolidColorBrush x:Key="BlueBrush" Color="#FF5AA9FF" />
    <SolidColorBrush x:Key="AmberBrush" Color="#FFFFB454" />
    <SolidColorBrush x:Key="GreyBrush" Color="#FF6B7480" />

    <SolidColorBrush x:Key="RedWashBrush" Color="#1FFF6B5E" />
    <SolidColorBrush x:Key="GreenWashBrush" Color="#1F55C96A" />
    <SolidColorBrush x:Key="BlueWashBrush" Color="#1F5AA9FF" />
    <SolidColorBrush x:Key="AmberWashBrush" Color="#1FFFB454" />

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>

    <!-- ==== The branded caption (design option 2c) ============================================= -->
    <!--
        EVERY NUMBER AND COLOUR BELOW IS READ OFF THE DESIGN, not chosen here. The source is
        `Claude Dashboard Window.dc.html`, option 2c, over the `classical-claude` system's
        `styles.css`:

          height:48px
          background: radial-gradient(120% 200% at 78% -60%, rgba(182,130,53,.16) 0%,
                                      rgba(182,130,53,0) 62%),
                      linear-gradient(180deg, #1f2429 0%, #1a1e23 100%)
          border-bottom: 1px solid rgba(182,130,53,.30)
          .cap  { width:46px; color:rgba(232,234,237,.85) }
          .cap:hover   { background:rgba(255,255,255,.06) }
          .cap-x:hover { background:#c42b1c; color:#fff }

        #b68235 is the system's accent colour, the same gold the application icon is drawn in,
        which is what makes the rule and the glow read as the app's own rather than as chrome.
        The alphas are the CSS fractions rounded to a byte: .16 -> 0x29, .30 -> 0x4D,
        .85 -> 0xD9, .06 -> 0x0F.
    -->
    <sys:Double x:Key="CaptionHeight">48</sys:Double>

    <LinearGradientBrush x:Key="CaptionBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF1F2429" Offset="0" />
        <GradientStop Color="#FF1A1E23" Offset="1" />
    </LinearGradientBrush>

    <!--
        The warm light off the top right. The CSS ellipse is 120% of the bar's width by 200% of
        its height, centred above the bar at (78%, -60%) — so only its lower edge falls across
        the caption, and the tint is strongest behind the summary rather than behind the title.
    -->
    <RadialGradientBrush x:Key="CaptionGlowBrush"
                         Center="0.78,-0.6" GradientOrigin="0.78,-0.6"
                         RadiusX="1.2" RadiusY="2.0">
        <GradientStop Color="#29B68235" Offset="0" />
        <GradientStop Color="#00B68235" Offset="0.62" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="CaptionRuleBrush" Color="#4DB68235" />
    <SolidColorBrush x:Key="CaptionGlyphBrush" Color="#D9E8EAED" />
    <SolidColorBrush x:Key="CaptionHoverBrush" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="CaptionCloseBrush" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="CaptionCloseGlyphBrush" Color="#FFFFFFFF" />

    <!--
        THE DESIGN'S SERIF IS NOT A WINDOWS FONT. 2c sets the title in Cormorant Garamond, which
        ships with the design system off Google Fonts and with nothing else; the task forbids
        downloading it. Constantia is the fallback and the one that will actually render on a
        stock install: a screen-cut old-style serif in the box since Vista, so the title carries
        the same voice on every machine rather than on the ones that happen to have Office.
        Cormorant Garamond stays at the head of the chain so an install that has it wins.
    -->
    <FontFamily x:Key="TitleFont">Cormorant Garamond, Constantia, Georgia, Times New Roman</FontFamily>

    <!--
        A caption button. 46 wide and the full height of the bar, which is the Windows 11
        geometry the design copied, and hit-test-visible in chrome so WindowChrome hands it the
        click instead of treating it as somewhere to drag from.
    -->
    <Style x:Key="CaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource CaptionGlyphBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource CaptionHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        MAXIMIZE AND RESTORE ARE TWO BUTTONS, one showing at a time. One button with a swapped
        command would leave the automation name and the glyph telling the operator to maximize a
        window that is already maximized, and 2c draws no maximized window to copy either from.

        THE HOVER IS BOUND, NOT TRIGGERED. CaptionChrome answers HTMAXBUTTON for this button so
        Windows will offer the Snap Layouts flyout, and that answer routes the pointer past WPF —
        IsMouseOver is never true here. The window reports the hover instead.
    -->
    <Style x:Key="CaptionMaximizeButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMaximizeHovered, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionHoverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CaptionRestoreButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsMaximizeHovered, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="{StaticResource CaptionHoverBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Close keeps the platform's red, which is the one thing about a caption nobody re-reads. -->
    <Style x:Key="CaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource CaptionCloseBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource CaptionCloseGlyphBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The caption's help slot. A bare glyph in 2c — no border, no chip — and inert here for the
        same reason "Mute all" below is: the action it would invoke does not exist yet. It is in
        the markup so the slot is claimed and whoever adds help has somewhere to put it.
    -->
    <Style x:Key="CaptionHelpButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ui:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
    <ui:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
    <ui:InverseBooleanToVisibilityConverter x:Key="BoolToCollapsed" />

    <!-- ==== The only two animations in the application ========================================= -->
    <Storyboard x:Key="BlinkStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.15" Duration="0:0:0.55" />
    </Storyboard>

    <Storyboard x:Key="BreatheStoryboard" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1.0" To="0.45" Duration="0:0:1.3">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ==== The status LED ===================================================================== -->
    <Style x:Key="LedStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="8,5,8,0" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Fill" Value="{StaticResource GreyBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Fill" Value="{StaticResource RedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Green">
                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                <Setter Property="Fill" Value="{StaticResource BlueBrush}" />
            </DataTrigger>

            <!-- Red blinks. -->
            <DataTrigger Binding="{Binding Motion}" Value="Blink">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="BlinkBegun" Storyboard="{StaticResource BlinkStoryboard}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BlinkBegun" />
                </DataTrigger.ExitActions>
            </DataTrigger>

            <!-- Working breathes. -->
            <DataTrigger Binding="{Binding Motion}" Value="Breathe">
                <DataTrigger.EnterActions>
                    <BeginStoryboard x:Name="BreatheBegun" Storyboard="{StaticResource BreatheStoryboard}" />
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                    <StopStoryboard BeginStoryboardName="BreatheBegun" />
                </DataTrigger.ExitActions>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The coloured spine down the left of an urgent row (mockups' .rail). -->
    <Style x:Key="RailStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="3" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Opacity" Value="0.7" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Fill" Value="{StaticResource RedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The state badge: "PERMISSION", "FINISHED", … -->
    <Style x:Key="BadgeStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Background" Value="{StaticResource RedWashBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Background" Value="{StaticResource AmberWashBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Green">
                <Setter Property="Background" Value="{StaticResource GreenWashBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                <Setter Property="Background" Value="{StaticResource BlueWashBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Accent}" Value="Red">
                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Amber">
                <Setter Property="Foreground" Value="{StaticResource AmberBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Green">
                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Every clickable row is a ToggleButton bound to an IsExpanded, so expanding is a binding
        rather than a click handler: keyboard-reachable, and no code-behind reaching into a
        DataContext to flip a flag.
    -->
    <Style x:Key="RowToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Surround"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="0,1,0,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surround" Property="Background" Value="{StaticResource RaisedBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surround" Property="Background" Value="{StaticResource RaisedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The toolbar's Grouped/Flat segmented control (2c's .seg: 11.5px, padding 5px 10px). -->
    <Style x:Key="SegmentStyle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chip" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The acknowledge action (Design Document §4 tier 2, §9). Enabled, and bound to the row's
        command — which publishes an event into the channel and changes nothing itself.
    -->
    <Style x:Key="AckButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chip" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The session id on the expanded row (§9, issue #15). Quiet by default — it is a reference,
        not an action the operator is being asked to take — and it lifts on hover the same way the
        Ack chip does, so it reads as clickable without saying so in words.

        NO STORYBOARD, and that is a rule rather than an omission: the hover is a static brush
        swap, exactly like AckButtonStyle above. "Red blinks; working breathes; nothing else
        moves." A test walks this dictionary and fails if a third animation appears.
    -->
    <Style x:Key="SessionIdButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A slot reserved for a phase that has not arrived: visible, inert, and honest about it. -->
    <Style x:Key="ReservedButtonStyle" TargetType="Button">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Opacity="0.75">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The toolbar row's buttons — 2c's `.mute`, which is one look for every button on that row:

          font: 400 11.5px [ui]; color: [ink3];
          border: 1px solid [hairline]; border-radius: 6px; padding: 5px 9px;
          :hover { background: [raised]; color: [ink2] }

        (The design names those five as CSS custom properties; they are written in brackets here
        only because an XML comment cannot carry two dashes in a row.)

        NO LONGER BASED ON ReservedButtonStyle. That style belongs to the row's terminal slot,
        which this task does not touch, and the two had drifted into sharing a base only because
        they once looked alike. Splitting them is what lets this row take the design's metrics
        without moving anything below it.
    -->
    <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chip" Property="Background" Value="{StaticResource RaisedBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chip" Property="Opacity" Value="0.75" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        And the same button for a slot whose phase has not arrived. 2c draws "Mute all" at full
        strength, and it is drawn dimmed anyway: the design shows the row it is going to be, and
        a control that cannot act must not look like one that can.
    -->
    <Style x:Key="HeaderReservedButtonStyle" TargetType="Button" BasedOn="{StaticResource HeaderButtonStyle}">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    </Style>


    <!-- ==== Roster prompt (Design Document §9) ================================================= -->
    <!--
        A row, not a dialog. It is the only thing in the product that asks the operator a question,
        and as a row it is driven by the same harness that realizes a window and invokes a command —
        so both of its paths are proved by the thing the operator actually uses, with no port whose
        adapter is then untested.

        NOT MODAL, AND SAFE BECAUSE OF WHAT DECLINING COSTS. The window can be used and dismissed
        with this unanswered, and an unanswered prompt is a declined one: the group is already
        formed and already unpersisted, so "no answer" and "no" leave the same state.

        The TextBox is the ROSTER's own name — a label, compared against nothing. There is no text
        field anywhere for a MEMBER name, because member names are only ever copied from rows:
        matching is exact, and a typed name that looked right but matched nothing would fail in
        silence.
    -->
    <DataTemplate DataType="{x:Type ui:RosterPromptViewModel}">
        <Border Margin="0,6,0,2"
                Padding="10,7"
                CornerRadius="6"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding Question}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{StaticResource InkBrush}" />

                <TextBox x:Name="RosterNameBox"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         Width="150"
                         Margin="10,0,10,0"
                         VerticalAlignment="Center"
                         FontSize="12"
                         AutomationProperties.Name="Roster name" />

                <Button x:Name="RememberRosterButton"
                        Content="Remember"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding RememberCommand}" />

                <Button x:Name="ForgetRosterButton"
                        Content="Just this once"
                        Style="{StaticResource HeaderButtonStyle}"
                        Command="{Binding ForgetCommand}" />
            </StackPanel>
        </Border>
    </DataTemplate>
    <!-- ==== Session row ======================================================================== -->
    <DataTemplate DataType="{x:Type ui:SessionViewModel}">
        <ToggleButton Style="{StaticResource RowToggleStyle}"
                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding RowName}">
            <Grid Margin="0,7,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle Grid.Column="0" Grid.RowSpan="2" Style="{StaticResource RailStyle}" />
                <Ellipse Grid.Column="1" Style="{StaticResource LedStyle}" />

                <StackPanel Grid.Column="2">
                    <!--
                        The context line is the session's TITLE, where it has one, and then the
                        prompt (Design Document §9). It used to be the prompt alone, and the
                        comment that stood here said the prompt was the session's name — which
                        stopped being true the moment a title could precede it (issue #18).

                        What names a session is its title; the prompt says what the session is
                        DOING. Only the prompt is terminal text, so only the prompt is set in the
                        mono face, and the two Runs are what let one wrapping line hold both.

                        Truncation, folding and the tooltip text are all the view model's — see
                        SessionViewModel.TitleClusters — so that they can be asserted without a
                        window. Nothing here formats or parses: a TextBlock renders a string as
                        characters, which is what keeps hook text data (TS §II.5).

                        The Runs are written adjacent on purpose. Whitespace between them would
                        become a space on the row, on top of the separator the view model already
                        supplies.

                        Mode=OneWay is required rather than decorative: Run.Text binds two-way by
                        default, and a two-way binding onto a read-only property throws while the
                        template loads — so the whole window fails to realize, not one row.
                    -->
                    <TextBlock FontFamily="{StaticResource MonoFont}"
                               FontSize="12"
                               LineHeight="16"
                               TextWrapping="Wrap"
                               MaxHeight="48"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource InkBrush}"><Run Text="{Binding TitlePrefix, Mode=OneWay}"
                                    FontFamily="{StaticResource UiFont}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource Ink2Brush}"
                                    ToolTip="{Binding TitleTooltip}" /><Run Text="{Binding PromptSnippet, Mode=OneWay}" /></TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Style="{StaticResource BadgeStyle}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource BadgeTextStyle}" />
                        </Border>
                        <TextBlock Text="{Binding Detail}"
                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisible}}"
                                   Margin="7,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink3Brush}" />
                        <!--
                            Why a row cannot be ticked, shown only while selecting. A row that does
                            nothing when clicked and says nothing is indistinguishable from a bug.
                        -->
                        <TextBlock Text="{Binding SelectionRefusal}"
                                   Visibility="{Binding SelectionRefusal, Converter={StaticResource EmptyToCollapsed}}"
                                   Margin="7,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink3Brush}" />

                        <TextBlock Text="{Binding AgeText}"
                                   Margin="7,0,0,0"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Ink3Brush}" />
                        <Border Margin="7,0,0,0"
                                Padding="5,0"
                                CornerRadius="4"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                Visibility="{Binding GroupTag, Converter={StaticResource EmptyToCollapsed}}">
                            <TextBlock Text="{Binding GroupTag}" FontSize="10"
                                       Foreground="{StaticResource Ink3Brush}" />
                        </Border>
                    </StackPanel>

                    <!-- The expanded exchange (Design Document §9). -->
                    <StackPanel Margin="0,10,0,2"
                                Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="2,0,0,0" Padding="12,0,0,0">
                            <StackPanel>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Ink3Brush}">
                                    <Run Text="YOU ASKED · " /><Run Text="{Binding AskedAtText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Prompt}"
                                           Margin="0,4,0,0"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource InkBrush}" />

                                <StackPanel Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVisible}}">
                                    <TextBlock Text="CLAUDE ANSWERED"
                                               Margin="0,14,0,4"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink3Brush}" />
                                    <!--
                                        Bounded and scrollable rather than faded out. §9 asks for
                                        the full exchange, and an answer can run to thousands of
                                        characters against a narrow panel: fading the tail away
                                        with no way to reach it would defeat the point of reading
                                        the answer here instead of switching to the terminal.
                                    -->
                                    <ScrollViewer MaxHeight="180"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock Text="{Binding Answer}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource Ink2Brush}" />
                                    </ScrollViewer>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="12,12,0,0">
                            <Button Content="✓ Acknowledge"
                                    Style="{StaticResource AckButtonStyle}"
                                    Margin="0,0,8,0"
                                    Command="{Binding AcknowledgeCommand}"
                                    Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisible}}"
                                    ToolTip="Mark this result seen." />
                            <Button Style="{StaticResource ReservedButtonStyle}"
                                    ToolTip="Opening the terminal arrives with Phase 2 navigation.">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open terminal" />
                                    <TextBlock Text="PHASE 2" FontSize="9" Margin="5,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!--
                                The session id (§9, issue #15). A Button rather than a TextBlock
                                with a mouse handler, so it is reachable by keyboard and announces
                                itself to a screen reader — clicking it is an action, and the
                                control that means "action" is the one to use.

                                Collapsed entirely when the session has no id. §9's expanded row is
                                a short list of things that are all there for a reason, and an
                                empty box or a bare "…" would be a fifth thing that means nothing.

                                Monospace for the same reason the prompt snippet is: it is terminal
                                text, and an id read character by character wants fixed advance.
                            -->
                            <Button Style="{StaticResource SessionIdButtonStyle}"
                                    Command="{Binding CopyIdCommand}"
                                    ToolTip="{Binding IdTooltip}"
                                    AutomationProperties.Name="{Binding IdTooltip}"
                                    Visibility="{Binding ShortId, Converter={StaticResource EmptyToCollapsed}}">
                                <TextBlock Text="{Binding ShortId}" FontFamily="{StaticResource MonoFont}" />
                            </Button>

                            <!--
                                Failure gets a surface; success gets none. A WPF tooltip closes on
                                the click that would trigger it and will not reopen while the
                                pointer stays put, so "Copied." could never be read at the moment
                                it meant anything — measured, not assumed. The absence of this
                                marker is the success signal.

                                It appears and stays. No animation, no fade, no timer: "red blinks;
                                working breathes; nothing else moves."
                            -->
                            <TextBlock Text="copy failed"
                                       FontSize="10"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource RedBrush}"
                                       ToolTip="The clipboard was held by another program. Try again."
                                       Visibility="{Binding CopyFailed, Converter={StaticResource BoolToVisible}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--
                    The acknowledge affordance §9 puts on the row itself, and the same command the
                    expanded row's button uses — they are one act, and two commands would be two
                    things to keep enabled in step.
                -->
                <Button Grid.Column="4"
                        Content="✓ Ack"
                        VerticalAlignment="Top"
                        Margin="8,2,0,0"
                        Style="{StaticResource AckButtonStyle}"
                        Command="{Binding AcknowledgeCommand}"
                        Visibility="{Binding CanAcknowledge, Converter={StaticResource BoolToVisible}}"
                        ToolTip="Mark this result seen." />
            </Grid>
        </ToggleButton>
    </DataTemplate>

    <!-- ==== Group heading ====================================================================== -->
    <DataTemplate DataType="{x:Type ui:GroupViewModel}">
        <ToggleButton Style="{StaticResource RowToggleStyle}"
                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Label}">
            <Grid Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="▼" FontSize="9" VerticalAlignment="Center"
                           Margin="0,0,7,0" Foreground="{StaticResource Ink3Brush}" />

                <TextBlock Grid.Column="1" Text="{Binding Label}"
                           FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource InkBrush}" />

                <!-- The stale line's own words: "· 2 sessions · quiet 38 min". -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsStale, Converter={StaticResource BoolToVisible}}">
                    <TextBlock FontSize="11.5" Foreground="{StaticResource Ink3Brush}">
                        <Run Text="· " /><Run Text="{Binding SessionCount, Mode=OneWay}" /><Run Text=" sessions · " /><Run Text="{Binding IdleText, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Workspace}"
                           Margin="8,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10.5"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource Ink3Brush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStale}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ItemsControl Grid.Column="3" ItemsSource="{Binding MemberAccents}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Ellipse Width="6" Height="6" Margin="3,0,0,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource GreyBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding}" Value="Red">
                                                <Setter Property="Fill" Value="{StaticResource RedBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Amber">
                                                <Setter Property="Fill" Value="{StaticResource AmberBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Green">
                                                <Setter Property="Fill" Value="{StaticResource GreenBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding}" Value="Blue">
                                                <Setter Property="Fill" Value="{StaticResource BlueBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ToggleButton>
    </DataTemplate>

    <!-- ==== Band heading (flat view) =========================================================== -->
    <DataTemplate DataType="{x:Type ui:BandHeaderViewModel}">
        <Grid Margin="12,12,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}"
                       FontSize="10" FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Accent}" Value="Red">
                                <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Green">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Accent}" Value="Blue">
                                <Setter Property="Foreground" Value="{StaticResource BlueBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <Rectangle Grid.Column="1" Height="1" Margin="8,0,0,0" VerticalAlignment="Center"
                       Fill="{StaticResource HairlineBrush}" />
        </Grid>
    </DataTemplate>

    <!-- ==== "+ 3 quiet" / "4 quiet sessions" =================================================== -->
    <DataTemplate DataType="{x:Type ui:QuietFooterViewModel}">
        <ToggleButton Style="{StaticResource RowToggleStyle}"
                      IsChecked="{Binding Owner.IsExpanded, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding Text}">
            <TextBlock Text="{Binding Text}"
                       Margin="34,5,12,9"
                       FontSize="11.5"
                       Foreground="{StaticResource Ink3Brush}" />
        </ToggleButton>
    </DataTemplate>

</ResourceDictionary>
