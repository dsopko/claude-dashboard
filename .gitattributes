# Normalize line endings; let Git decide text vs binary.
* text=auto

# Windows/.NET tooling files are happiest with CRLF.
*.sln    text eol=crlf
*.csproj text eol=crlf
*.props  text eol=crlf
*.targets text eol=crlf
*.ps1    text eol=crlf

# Keep these LF.
*.sh   text eol=lf
*.cs   text eol=lf diff=csharp
*.md   text eol=lf
*.json text eol=lf
*.html text eol=lf

# Treat these as binary.
*.png binary
*.ico binary
*.wav binary
